include LICENSE
include README.md
include pyproject.toml
include data/.keep
recursive-include vrh *
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.joblib
global-exclude vrh/baseline/prosst/static/*
prune vrh/baseline/prosst/static
prune vrh/legacy
prune test
prune tests
prune data
prune docs
prune experiments
prune script
prune img
prune tools
prune .github
global-exclude *.png
global-exclude *.jpg
global-exclude *.jpeg
